# Search behavior -----------------------------------------------------------
# Minimum seconds between public-search request starts across local processes.
# The legacy variable name is retained for configuration compatibility.
ARCHON_WEB_DUCKDUCKGO_INTERVAL=2.0

# Optional per-user state file shared by automatically started stdio servers.
# ARCHON_WEB_RATE_LIMIT_FILE=~/.cache/archon-web/duckduckgo-rate-limit

# Upstream request timeout in seconds (1-120).
ARCHON_WEB_TIMEOUT=10

# Optional HTTP/HTTPS/SOCKS5 proxy. Credentials may be included in the URL.
# ARCHON_WEB_PROXY=http://127.0.0.1:7890

# MCP service ---------------------------------------------------------------
# stdio (default) | streamable-http | sse
ARCHON_WEB_TRANSPORT=stdio

# Used by streamable-http and sse transports. The loopback default is safest.
ARCHON_WEB_HOST=127.0.0.1
ARCHON_WEB_PORT=8000
ARCHON_WEB_LOG_LEVEL=INFO

# Streamable HTTP endpoint and optional stateless mode.
ARCHON_WEB_STREAMABLE_HTTP_PATH=/mcp
ARCHON_WEB_STATELESS_HTTP=false

# Legacy SSE endpoints.
ARCHON_WEB_SSE_PATH=/sse
ARCHON_WEB_MESSAGE_PATH=/messages/
