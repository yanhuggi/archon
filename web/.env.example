# ── API Keys ──────────────────────────────────
# Tavily (get one at https://tavily.com)
# TAVILY_API_KEY=tvly-your-api-key-here
# DeepSeek (get one at https://platform.deepseek.com)
# DEEPSEEK_API_KEY=sk-your-api-key-here

# ── API Base URL (optional, for self-hosted/proxy) ──
# Tavily（完整 URL，Tavily 无 base + path 概念）
# TAVILY_API_URL=https://api.tavily.com/search
# DeepSeek BASE_URL（自动拼接 /v1/chat/completions）
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── DuckDuckGo (opt-in, no API key required) ──
# ARCHON_WEB_DUCKDUCKGO_ENABLED=true

# ── Default provider (optional, when multiple keys configured) ──
# Values: tavily | deepseek | duckduckgo
# ARCHON_WEB_PROVIDER=tavily

# ── Advanced (optional) ──
# HTTP timeout for search API calls (seconds, default: 30)
# ARCHON_WEB_TIMEOUT=30
# Enable DeepSeek extended thinking (consumes extra tokens)
# ARCHON_WEB_DEEPSEEK_THINKING=false
