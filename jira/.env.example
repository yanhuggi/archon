# Jira Server Connection (required)
JIRA_URL=https://jira.example.com
JIRA_USERNAME=your-username
JIRA_PASSWORD=your-password

# Advanced (optional)
# HTTP timeout for Jira API calls (seconds, default: 30)
# JIRA_TIMEOUT=30
# Maximum attachment download size in bytes (default: 10485760 = 10MB)
# JIRA_MAX_ATTACHMENT_SIZE=10485760
