# Jira Server session authentication ----------------------------------------
JIRA_URL=https://jira.example.com
JIRA_USERNAME=your-username
JIRA_PASSWORD=your-password

# Provider behavior ---------------------------------------------------------
JIRA_TIMEOUT=30
JIRA_MAX_ATTACHMENT_SIZE=10485760

# Downloaded attachments and exported documents must remain under this path.
# If omitted, the MCP client's current working directory is used.
# Forward slashes work on Windows.
# JIRA_ALLOWED_OUTPUT_DIR=C:/Users/name/Documents/Jira

# Existing output files are protected by default.
JIRA_ALLOW_OVERWRITE=false

# An expired Jira session is re-authenticated and the request retried once.
# Reads are always retried. Writes are not, because a reverse proxy or SSO
# gateway can rewrite a response after forwarding the request, which would turn
# the retry into a duplicate comment or transition. Enable only after verifying
# that your edge returns 401 before the request reaches Jira.
JIRA_RETRY_MUTATIONS_ON_401=false

# JQL metadata cache --------------------------------------------------------
# Field definitions and value suggestions use memory plus atomic JSON files.
# The cache identity is derived from JIRA_URL + JIRA_USERNAME, never password.
JIRA_JQL_DISK_CACHE=true
# JIRA_JQL_CACHE_DIR=C:/Users/name/AppData/Local/archon-jira/Cache
JIRA_JQL_FIELD_REFRESH_INTERVAL=900
JIRA_JQL_VALUE_REFRESH_INTERVAL=1800
JIRA_JQL_VALUE_CACHE_MAX_ENTRIES=500
# Old data may be used only when refresh fails, for at most seven days.
JIRA_JQL_CACHE_MAX_STALE=604800

# MCP service ---------------------------------------------------------------
# stdio (default) | streamable-http | sse
ARCHON_JIRA_TRANSPORT=stdio
ARCHON_JIRA_HOST=127.0.0.1
ARCHON_JIRA_PORT=8000
ARCHON_JIRA_LOG_LEVEL=INFO

ARCHON_JIRA_STREAMABLE_HTTP_PATH=/mcp
ARCHON_JIRA_STATELESS_HTTP=false
ARCHON_JIRA_SSE_PATH=/sse
ARCHON_JIRA_MESSAGE_PATH=/messages/
