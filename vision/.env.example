# MiMo provider -------------------------------------------------------------
# Required for successful analysis. The tool remains discoverable without it
# and returns configuration_error when called.
MIMO_API_KEY=your-api-key-here

# OpenAI-compatible API base URL and model.
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5

# Upstream timeout, completion budget, and maximum decoded image size.
MIMO_TIMEOUT=120
MIMO_MAX_TOKENS=2048
MIMO_MAX_IMAGE_MB=50

# Optional boundary for local image reads. When set, a local file's real path
# (after resolving symlinks) must sit under this directory. When omitted, any
# readable local path is allowed. Forward slashes work on Windows.
# MIMO_ALLOWED_DIR=C:/Users/name/Pictures

# MCP service ---------------------------------------------------------------
# stdio (default) | streamable-http | sse
ARCHON_VISION_TRANSPORT=stdio
ARCHON_VISION_HOST=127.0.0.1
ARCHON_VISION_PORT=8000
ARCHON_VISION_LOG_LEVEL=INFO

ARCHON_VISION_STREAMABLE_HTTP_PATH=/mcp
ARCHON_VISION_STATELESS_HTTP=false
ARCHON_VISION_SSE_PATH=/sse
ARCHON_VISION_MESSAGE_PATH=/messages/
