# ── MiMo API Key (get one at https://mimo.mi.com) ──
# MIMO_API_KEY=your-api-key-here

# ── MiMo Base URL (optional, default: https://api.xiaomimimo.com/v1) ──
# 代码自动拼接 /chat/completions 得到完整 API 路径。
# 按量付费：https://api.xiaomimimo.com/v1
# Token Plan：https://token-plan-cn.xiaomimimo.com/v1
# MIMO_BASE_URL=https://api.xiaomimimo.com/v1

# ── MiMo Model (optional, default: mimo-v2.5) ──
# MIMO_MODEL=mimo-v2.5

# ── Local file access (optional) ──
# Restrict local file reads to this directory (security). Default: server/ parent dir.
# MIMO_ALLOWED_DIR=/path/to/allowed
